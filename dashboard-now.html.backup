<div class="nxs8" id="prozess">
<style>
  .nxs8{--pink:#FF2D7A;--ink:#0A0A0C;--line:rgba(255,255,255,.09);--text:#F5F2EC;--muted:#9A968C;
    font-family:'Satoshi',-apple-system,sans-serif;background:var(--ink);color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased}
  .nxs8 *{box-sizing:border-box;margin:0;padding:0}
  .nxs8 .wrap{max-width:1140px;margin:0 auto;padding:84px 22px}
  .nxs8 .head{text-align:center;max-width:680px;margin:0 auto 48px}
  .nxs8 .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);display:inline-flex;align-items:center;gap:9px;margin-bottom:16px}
  .nxs8 .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--pink)}
  .nxs8 h2{font-family:'Clash Display',sans-serif;font-weight:600;font-size:clamp(1.9rem,5.2vw,3rem);letter-spacing:-.02em;line-height:1.05}
  .nxs8 .steps{display:grid;grid-template-columns:repeat(5,1fr);position:relative}
  .nxs8 .steps::before{content:"";position:absolute;top:26px;left:8%;right:8%;height:2px;background:linear-gradient(90deg,var(--pink),rgba(255,45,122,.15))}
  .nxs8 .step{text-align:center;padding:0 12px;position:relative}
  .nxs8 .sn{width:54px;height:54px;border-radius:50%;background:var(--ink);border:2px solid var(--pink);color:var(--pink);font-family:'Clash Display',sans-serif;font-weight:600;font-size:1.2rem;display:grid;place-items:center;margin:0 auto 20px;position:relative;z-index:1}
  .nxs8 .step h3{font-family:'Clash Display',sans-serif;font-weight:600;font-size:1rem;letter-spacing:.05em;text-transform:uppercase;margin-bottom:6px}
  .nxs8 .dur{font-size:.78rem;color:var(--pink);font-weight:600;margin-bottom:8px}.nxs8 .step p{font-size:.86rem;color:var(--muted)}
  .nxs8 .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
  .nxs8 .reveal.in{opacity:1;transform:none}
  @media(max-width:900px){.nxs8 .steps{grid-template-columns:1fr 1fr;gap:32px 0}.nxs8 .steps::before{display:none}}
  @media(max-width:760px){.nxs8 .wrap{padding:60px 22px}}
</style>
  <div class="wrap">
    <div class="head reveal"><span class="eyebrow">So läuft's ab</span><h2>Fünf Schritte. 6–10 Wochen. Fertig.</h2></div>
    <div class="steps">
      <div class="step reveal"><div class="sn">01</div><h3>Verstehen</h3><div class="dur">1–2 Wochen</div><p>Wir analysieren Ihre Tools, KPIs und Workflows.</p></div>
      <div class="step reveal"><div class="sn">02</div><h3>Konzipieren</h3><div class="dur">1 Woche</div><p>Wireframes, Datenstruktur, Konzept abgestimmt.</p></div>
      <div class="step reveal"><div class="sn">03</div><h3>Bauen</h3><div class="dur">3–5 Wochen</div><p>Wöchentlicher Fortschritt, laufendes Feedback.</p></div>
      <div class="step reveal"><div class="sn">04</div><h3>Testen</h3><div class="dur">1 Woche</div><p>Datenquellen geprüft, Stakeholder testen, Go-Live.</p></div>
      <div class="step reveal"><div class="sn">05</div><h3>Bleiben</h3><div class="dur">Optional</div><p>Hosting, Wartung & Weiterentwicklung.</p></div>
    </div>
  </div>
<script>
(function(){var w=document.querySelector('.nxs8');if(!w)return;var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.15});w.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});})();
</script>
</div>

