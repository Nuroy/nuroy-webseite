<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Custom Dashboards für Unternehmen | Nuroy</title>

  <!-- SEO: NOINDEX (Funnel-Seite nur über Ads) -->
  <meta name="robots" content="noindex, nofollow, noarchive">

  <!-- Meta Description -->
  <meta name="description" content="Custom Dashboards für Unternehmen ab 10 Mitarbeitern. Alle Daten in Echtzeit an einem Ort. ROI-Rechner & Booking.">

  <!-- Facebook Domain Verification -->
  <meta name="facebook-domain-verification" content="685dxfgmj3yn96tljrpdoyqb4mtl2c" />

  <!-- OG Tags -->
  <meta property="og:title" content="Custom Dashboard — Alle Tools, ein System">
  <meta property="og:description" content="Weniger Reporting. Mehr Wachstum. ROI jetzt berechnen.">
  <meta property="og:image" content="https://nuroy.de/assets/funnel-og-image.jpg">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://nuroy.de/dashboard-now">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="assets/favicon.png">

  <!-- Preconnects -->
  <link rel="preconnect" href="https://api.fontshare.com">
  <link rel="preconnect" href="https://assets.calendly.com">
  <link rel="preconnect" href="https://connect.facebook.net">

  <!-- Fonts: Clash Display, Satoshi (via Fontshare) -->
  <link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">

  <!-- Critical CSS - Above Fold -->
  <style>
    /* Reset & Base */
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Satoshi', -apple-system, sans-serif;
      background: #0A0A0C;
      color: #F5F2EC;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      margin: 0;
      padding: 0;
    }

    /* Fixed Header */
    .dashboard-now-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 68px;
      background: rgba(10, 10, 12, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 45, 122, 0.15);
      z-index: 1000;
    }
    .dashboard-now-header .container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 22px;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }
    .header-logo {
      display: flex;
      align-items: center;
      gap: 9px;
      font-family: 'Clash Display', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: #F5F2EC;
      text-decoration: none;
    }
    .header-logo .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #FF2D7A;
      box-shadow: 0 0 12px #FF2D7A;
    }
    .nav-links {
      display: flex;
      gap: 24px;
      align-items: center;
    }
    .nav-links a {
      color: #9A968C;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: #FF2D7A;
    }
    .btn {
      display: inline-block;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      white-space: nowrap;
      border: none;
      cursor: pointer;
    }
    .btn-primary {
      background: #FF2D7A;
      color: #fff;
    }
    .btn-primary:hover {
      background: #D01F5E;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255, 45, 122, 0.3);
    }
    .btn-secondary {
      background: transparent;
      color: #F5F2EC;
      border: 1px solid rgba(255, 255, 255, 0.09);
    }
    .btn-secondary:hover {
      border-color: #FF2D7A;
      color: #FF2D7A;
      transform: translateY(-2px);
    }

    /* Page Wrapper */
    .page-wrapper {
      padding-top: 68px;
    }

    /* Mobile Nav */
    @media (max-width: 900px) {
      .nav-links { display: none; }
      .dashboard-now-header .btn { padding: 10px 20px; font-size: 13px; }
      .header-logo { font-size: 18px; }
    }
  </style>

  <!-- Shared Design System -->
  <link rel="stylesheet" href="shared/styles.css">

  <!-- Funnel Base Styles -->
  <link rel="stylesheet" href="funnel/funnel-styles.css?v=3.9">

  <!-- Qualification Flow Styles -->
  <link rel="stylesheet" href="funnel/funnel-qualification.css?v=3.0">

  <!-- Dashboard-Now Specific Styles -->
  <link rel="stylesheet" href="funnel/dashboard-now-styles.css?v=1.0">

  <!-- Lite YouTube Embed -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.2/src/lite-yt-embed.min.css">

  <!-- Funnel Config (MUST load before tracking scripts) -->
  <script src="config/funnel-config.js"></script>

  <!-- Tracking: Meta Pixel -->
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');

    // Pixel ID aus Config lesen
    const pixelId = window.NUROY_CONFIG?.META_PIXEL_ID;
    if (pixelId && !pixelId.includes('PLACEHOLDER')) {
      fbq('init', pixelId);
      fbq('track', 'PageView');
    }
  </script>
  <noscript>
    <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1012481877892496&ev=PageView&noscript=1" />
  </noscript>
</head>
<body>

<!-- Fixed Header -->
<header class="dashboard-now-header">
  <div class="container">
    <a href="/" class="header-logo">
      <img src="assets/logo-full.png" alt="Nuroy" class="header-logo-img">
    </a>
    <nav class="nav-links">
      <a href="#roi">ROI-Rechner</a>
      <a href="#features">Features</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a href="#booking" class="btn btn-primary">Gespräch buchen</a>
  </div>
</header>

<!-- Page Content -->
<div class="page-wrapper">

<!-- ══════════════════════════════════════════════════════════ -->
<!-- SEKTION 1: HERO -->
<!-- ══════════════════════════════════════════════════════════ -->
<!-- NUROY · SEKTION 01 · HERO — eigenständiger Custom-Code-Block -->
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
<div class="nxs1">
<style>
  .nxs1{--pink:#FF2D7A;--pink-deep:#D01F5E;--ink:#0A0A0C;--surface:#1C1C22;--surface2:#2A2A32;--line:rgba(255,255,255,.09);--text:#F5F2EC;--muted:#9A968C;--ok:#8FA373;--red:#FF5F57;--amber:#FFBD2E;
    font-family:'Satoshi',-apple-system,sans-serif;background:var(--ink);color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased;position:relative;overflow:hidden}
  .nxs1 *{box-sizing:border-box;margin:0;padding:0}
  .nxs1::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(255,45,122,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,45,122,.04) 1px,transparent 1px);background-size:48px 48px;-webkit-mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000,transparent 75%);mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000,transparent 75%)}
  .nxs1 .wrap{max-width:1140px;margin:0 auto;padding:64px 22px;position:relative;z-index:1}
  .nxs1 .grid{display:grid;grid-template-columns:1.05fr .95fr;gap:54px;align-items:center}
  .nxs1 .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);display:inline-flex;align-items:center;gap:9px;margin-bottom:18px}
  .nxs1 .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--pink)}
  .nxs1 h1{font-family:'Clash Display',sans-serif;font-weight:600;font-size:clamp(2.5rem,8vw,4.4rem);line-height:1.05;letter-spacing:-.02em}
  .nxs1 h1 span{display:block}.nxs1 h1 .l2{color:var(--pink)}
  .nxs1 .lead{font-size:clamp(1.02rem,2.4vw,1.2rem);color:var(--muted);max-width:540px;margin:26px 0 30px}
  .nxs1 .checks{display:flex;flex-direction:column;gap:7px}
  .nxs1 .c{display:flex;align-items:center;gap:9px;font-size:14px;color:var(--muted)}
  .nxs1 .mock{background:linear-gradient(160deg,var(--surface2),var(--surface));border:1px solid var(--line);border-radius:22px;padding:18px;box-shadow:0 40px 80px -30px rgba(0,0,0,.7);position:relative;overflow:hidden}
  .nxs1 .mock::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% -10%,rgba(255,45,122,.16),transparent 55%);pointer-events:none}
  .nxs1 .mt{display:flex;align-items:center;gap:7px;margin-bottom:16px}
  .nxs1 .mt i{width:10px;height:10px;border-radius:50%}
  .nxs1 .mt i:nth-child(1){background:var(--red)}.nxs1 .mt i:nth-child(2){background:var(--amber)}.nxs1 .mt i:nth-child(3){background:#28CA41}
  .nxs1 .mt span{margin-left:auto;font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px}
  .nxs1 .mt span::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--pink);box-shadow:0 0 8px var(--pink);animation:nxs1p 1.6s infinite}
  @keyframes nxs1p{0%,100%{opacity:1}50%{opacity:.3}}
  .nxs1 .kpis{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-bottom:13px}
  .nxs1 .mk{background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:12px;padding:13px 14px}
  .nxs1 .mk .lbl{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
  .nxs1 .mk .val{font-family:'Clash Display',sans-serif;font-weight:600;font-size:24px;margin-top:5px}
  .nxs1 .mk .val.p{color:var(--pink)}
  .nxs1 .mk .tr{font-size:11px;margin-top:3px;color:var(--ok)}.nxs1 .mk .tr.dn{color:var(--red)}
  .nxs1 .chart{background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:12px;padding:14px;height:108px;display:flex;align-items:flex-end;gap:7px}
  .nxs1 .chart .bar{flex:1;background:linear-gradient(180deg,var(--pink),rgba(255,45,122,.25));border-radius:4px 4px 0 0;transform-origin:bottom;animation:nxs1g 1.1s cubic-bezier(.22,1,.36,1) backwards}
  @keyframes nxs1g{from{transform:scaleY(0)}}
  .nxs1 .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
  .nxs1 .reveal.in{opacity:1;transform:none}
  @media(max-width:900px){.nxs1 .grid{grid-template-columns:1fr;gap:40px}}
</style>
  <div class="wrap grid">
    <div class="reveal">
      <span class="eyebrow">Custom Dashboards für Unternehmen ab 10 MA</span>
      <h1><span>Alle Ihre Daten.</span><span class="l2">An einem Ort.</span><span>Im Überblick.</span></h1>
      <p class="lead">Schluss mit 5 Tools und 5 Wahrheiten. Wir bauen Ihnen ein Live-Dashboard, das alle Kennzahlen vereint — DSGVO-konform, in Echtzeit, auf Ihre Definitionen zugeschnitten.</p>
      <div class="checks">
        <div class="c"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="#FF2D7A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Keine Verkaufsmasche</div>
        <div class="c"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="#FF2D7A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Konkrete Antworten auf Ihre Situation</div>
        <div class="c"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="#FF2D7A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Passt es nicht, sagen wir's offen</div>
      </div>
    </div>
    <div class="mock reveal">
      <div class="mt"><i></i><i></i><i></i><span>Live-Daten</span></div>
      <div class="kpis">
        <div class="mk"><div class="lbl">Umsatz MTD</div><div class="val p">€284.910</div><div class="tr">▲ 12,4 %</div></div>
        <div class="mk"><div class="lbl">Operative Marge</div><div class="val">31,8 %</div><div class="tr">▲ 2,1 pp</div></div>
        <div class="mk"><div class="lbl">CPL Ø</div><div class="val">€42</div><div class="tr dn">▼ 8 %</div></div>
        <div class="mk"><div class="lbl">Leads</div><div class="val p">1.204</div><div class="tr">▲ 18 %</div></div>
      </div>
      <div class="chart" data-chart></div>
    </div>
  </div>
<script>
(function(){var w=document.querySelector('.nxs1');if(!w)return;
  var mc=w.querySelector('[data-chart]');if(mc){[42,58,49,66,71,63,78,85,74,92,88,100].forEach(function(v,i){var b=document.createElement('div');b.className='bar';b.style.height=v+'%';b.style.animationDelay=(i*.06)+'s';mc.appendChild(b);});}
  var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.15});
  w.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
})();
</script>
</div>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- CTA #1: Nach Hero -->
<!-- ══════════════════════════════════════════════════════════ -->
<section class="cta-block cta-block--hero">
  <div class="container">
    <div class="cta-content">
      <p class="cta-eyebrow">Neugierig geworden?</p>
      <h3 class="cta-headline">Sehen Sie, wie Ihr Dashboard aussehen könnte.</h3>
      <div class="cta-buttons">
        <a href="#booking" class="btn btn-primary">Kostenloses Gespräch buchen →</a>
        <a href="#roi" class="btn btn-secondary">ROI berechnen ↓</a>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- SEKTION 2: TRUST BAR -->
<!-- ══════════════════════════════════════════════════════════ -->
<!-- NUROY · SEKTION 02 · KUNDENLOGOS — eigenständiger Custom-Code-Block -->
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
<div class="nxs2">
<style>
  .nxs2{--pink:#FF2D7A;--ink:#0A0A0C;--line:rgba(255,255,255,.09);--muted:#9A968C;
    font-family:'Satoshi',-apple-system,sans-serif;background:var(--ink);color:var(--muted);-webkit-font-smoothing:antialiased}
  .nxs2 *{box-sizing:border-box;margin:0;padding:0}
  .nxs2 .wrap{max-width:1140px;margin:0 auto;padding:34px 22px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .nxs2 p{text-align:center;font-size:12px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px}
  .nxs2 .mq{display:flex;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
  .nxs2 .track{display:flex;gap:60px;align-items:center;animation:nxs2s 26s linear infinite;flex-shrink:0;padding-right:60px}
  .nxs2 .track img{height:30px;opacity:.55;filter:grayscale(1) brightness(1.6)}
  @keyframes nxs2s{to{transform:translateX(-50%)}}
</style>
  <div class="wrap">
    <p>Vertrauen von Unternehmen wie</p>
    <div class="mq"><div class="track" data-track></div></div>
  </div>
<script>
(function(){var w=document.querySelector('.nxs2');if(!w)return;var t=w.querySelector('[data-track]');if(!t)return;
  var L=['https://nuroy.de/assets/clients/sniffys.png','https://nuroy.de/assets/clients/nomo.png'];var s=[];for(var k=0;k<12;k++){s=s.concat(L);}
  s.concat(s).forEach(function(src){var img=document.createElement('img');img.src=src;img.alt='Kunde';img.onerror=function(){this.style.display='none';};t.appendChild(img);});
})();
</script>
</div>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- SEKTION 3: PROBLEM -->
<!-- ══════════════════════════════════════════════════════════ -->
<!-- NUROY · SEKTION 03 · PROBLEM — eigenständiger Custom-Code-Block -->
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
<div class="nxs3">
<style>
  .nxs3{--pink:#FF2D7A;--ink:#0A0A0C;--surface:#1C1C22;--line:rgba(255,255,255,.09);--text:#F5F2EC;--muted:#9A968C;--red:#FF5F57;
    font-family:'Satoshi',-apple-system,sans-serif;background:var(--ink);color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased}
  .nxs3 *{box-sizing:border-box;margin:0;padding:0}
  .nxs3 .wrap{max-width:1140px;margin:0 auto;padding:84px 22px}
  .nxs3 .head{text-align:center;max-width:680px;margin:0 auto 48px}
  .nxs3 .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);display:inline-flex;align-items:center;gap:9px;margin-bottom:16px}
  .nxs3 .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--pink)}
  .nxs3 h2{font-family:'Clash Display',sans-serif;font-weight:600;font-size:clamp(1.9rem,5.2vw,3rem);letter-spacing:-.02em;line-height:1.05}
  .nxs3 .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:38px}
  .nxs3 .pc{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:26px;transition:transform .25s,border-color .25s}
  .nxs3 .pc:hover{transform:translateY(-4px);border-color:rgba(255,95,87,.4)}
  .nxs3 .amp{width:13px;height:13px;border-radius:50%;background:var(--red);box-shadow:0 0 14px rgba(255,95,87,.6);margin-bottom:18px}
  .nxs3 .pc h3{font-family:'Clash Display',sans-serif;font-weight:600;font-size:1.3rem;margin-bottom:8px}
  .nxs3 .pc p{color:var(--muted);font-size:.96rem}
  .nxs3 .foot{font-family:'Clash Display',sans-serif;font-weight:500;font-size:1.25rem;text-align:center;max-width:640px;margin:0 auto}
  .nxs3 .foot b{color:var(--pink)}
  .nxs3 .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
  .nxs3 .reveal.in{opacity:1;transform:none}
  @media(max-width:760px){.nxs3 .wrap{padding:60px 22px}.nxs3 .cards{grid-template-columns:1fr}}
</style>
  <div class="wrap">
    <div class="head reveal"><span class="eyebrow">Wenn Ihr Reporting so aussieht …</span><h2>Erkennen Sie sich wieder?</h2></div>
    <div class="cards">
      <div class="pc reveal"><div class="amp"></div><h3>Excel-Tabellen</h3><p>… die niemand mehr aktuell hält. Jede Abteilung pflegt ihre eigene Version.</p></div>
      <div class="pc reveal"><div class="amp"></div><h3>5 Tools, 5 Wahrheiten</h3><p>CRM sagt X, Ads sagt Y, Buchhaltung sagt Z. Welcher Zahl vertrauen Sie jetzt?</p></div>
      <div class="pc reveal"><div class="amp"></div><h3>Reporting kostet 1 Tag</h3><p>Pro Woche. Manuell zusammengeklickt — und trotzdem schon veraltet.</p></div>
    </div>
    <p class="foot reveal">… dann sind Sie nicht allein. <b>Und Sie sind genau richtig hier.</b></p>
  </div>
<script>
(function(){var w=document.querySelector('.nxs3');if(!w)return;var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.15});w.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});})();
</script>
</div>

