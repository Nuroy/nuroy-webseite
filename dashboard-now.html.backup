<!-- NUROY · SEKTION 09 · FAQ — eigenständiger Custom-Code-Block -->
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
<div class="nxs9" id="faq">
<style>
  .nxs9{--pink:#FF2D7A;--ink:#0A0A0C;--surface:#1C1C22;--line:rgba(255,255,255,.09);--text:#F5F2EC;--muted:#9A968C;
    font-family:'Satoshi',-apple-system,sans-serif;background:var(--ink);color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased}
  .nxs9 *{box-sizing:border-box;margin:0;padding:0}
  .nxs9 .wrap{max-width:1140px;margin:0 auto;padding:84px 22px}
  .nxs9 .head{text-align:center;max-width:680px;margin:0 auto 44px}
  .nxs9 .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);display:inline-flex;align-items:center;gap:9px;margin-bottom:16px}
  .nxs9 .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--pink)}
  .nxs9 h2{font-family:'Clash Display',sans-serif;font-weight:600;font-size:clamp(1.9rem,5.2vw,3rem);letter-spacing:-.02em;line-height:1.05}
  .nxs9 .list{max-width:780px;margin:0 auto}
  .nxs9 .faq{border:1px solid var(--line);border-radius:14px;margin-bottom:12px;background:var(--surface);overflow:hidden;transition:border-color .2s}
  .nxs9 .faq.open{border-color:var(--pink)}
  .nxs9 .q{width:100%;text-align:left;padding:22px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;font-weight:600;font-size:1.04rem;cursor:pointer;background:none;border:none;color:inherit;font-family:inherit}
  .nxs9 .ic{flex-shrink:0;width:24px;height:24px;position:relative;transition:transform .3s}
  .nxs9 .faq.open .ic{transform:rotate(45deg)}
  .nxs9 .ic::before,.nxs9 .ic::after{content:"";position:absolute;background:var(--pink);border-radius:2px;top:50%;left:50%;transform:translate(-50%,-50%)}
  .nxs9 .ic::before{width:14px;height:2px}.nxs9 .ic::after{width:2px;height:14px}
  .nxs9 .a{max-height:0;overflow:hidden;transition:max-height .35s ease}
  .nxs9 .a p{padding:0 24px 22px;color:var(--muted);font-size:.97rem}
  .nxs9 .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
  .nxs9 .reveal.in{opacity:1;transform:none}
  @media(max-width:760px){.nxs9 .wrap{padding:60px 22px}}
</style>
  <div class="wrap">
    <div class="head reveal"><span class="eyebrow">Was uns oft gefragt wird</span><h2>Antworten, bevor Sie fragen.</h2></div>
    <div class="list reveal" data-faq></div>
  </div>
<script>
(function(){var w=document.querySelector('.nxs9');if(!w)return;var fl=w.querySelector('[data-faq]');
  [['Was kostet das ungefähr?','Die Kosten hängen vom Umfang und Ihren Anforderungen ab. Im Discovery-Call besprechen wir Ihr Projekt und erstellen ein passgenaues Angebot.'],['Wie lange dauert das Projekt?','Je nach Komplexität 6–10 Wochen. Im Discovery-Call erstellen wir einen konkreten Zeitplan.'],['Welche Tools können Sie anbinden?','Alles mit API: Salesforce, HubSpot, Shopify, Google Analytics, Meta Ads, Stripe, eigene Datenbanken, ERPs — und vieles mehr.'],['Was passiert, wenn wir Tools wechseln?','Wir bauen so, dass neue Tools einfach integriert werden. Bei Wechsel: 1–2 Wochen für die Anbindung.'],['Wo werden unsere Daten gehostet?','In Deutschland (Frankfurt), DSGVO-konform. Alternativ On-Premise bei Ihnen.'],['Was, wenn wir selbst bauen wollen?','Sinnvoll mit eigenem Dev-Team. Wir liefern auch nur Discovery & Tech-Spec (2 Wochen, 5.000 €).']].forEach(function(q){var d=document.createElement('div');d.className='faq';d.innerHTML='<button class="q">'+q[0]+'<span class="ic"></span></button><div class="a"><p>'+q[1]+'</p></div>';fl.appendChild(d);d.querySelector('.q').addEventListener('click',function(){var op=d.classList.contains('open');fl.querySelectorAll('.faq').forEach(function(x){x.classList.remove('open');x.querySelector('.a').style.maxHeight=null;});if(!op){d.classList.add('open');var a=d.querySelector('.a');a.style.maxHeight=a.scrollHeight+'px';}});});
  var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.15});w.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
})();
</script>
</div>

