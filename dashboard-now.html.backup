<!-- NUROY · SEKTION 05 · ROI-RECHNER — eigenständiger Custom-Code-Block -->
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
<div class="nxs5" id="roi">
<style>
  .nxs5{--pink:#FF2D7A;--pink-deep:#D01F5E;--ink:#0A0A0C;--surface:#1C1C22;--surface2:#2A2A32;--line:rgba(255,255,255,.09);--text:#F5F2EC;--muted:#9A968C;
    font-family:'Satoshi',-apple-system,sans-serif;background:var(--ink);color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased}
  .nxs5 *{box-sizing:border-box;margin:0;padding:0}
  .nxs5 .wrap{max-width:1140px;margin:0 auto;padding:84px 22px}
  .nxs5 .head{text-align:center;max-width:680px;margin:0 auto 48px}
  .nxs5 .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);display:inline-flex;align-items:center;gap:9px;margin-bottom:16px}
  .nxs5 .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--pink)}
  .nxs5 h2{font-family:'Clash Display',sans-serif;font-weight:600;font-size:clamp(1.9rem,5.2vw,3rem);letter-spacing:-.02em;line-height:1.05}
  .nxs5 .sub{margin-top:18px;color:var(--muted);font-size:1.05rem}
  .nxs5 .card{background:linear-gradient(150deg,var(--surface2),var(--surface));border:1px solid var(--line);border-radius:26px;padding:clamp(26px,4vw,46px);display:grid;grid-template-columns:1fr 1fr;gap:46px;align-items:center;box-shadow:0 40px 90px -40px rgba(0,0,0,.7);position:relative;overflow:hidden}
  .nxs5 .card::before{content:"";position:absolute;top:-40%;right:-10%;width:380px;height:380px;background:radial-gradient(circle,rgba(255,45,122,.14),transparent 65%);pointer-events:none}
  .nxs5 .in{margin-bottom:30px}.nxs5 .in:last-child{margin-bottom:0}
  .nxs5 .in label{display:flex;justify-content:space-between;font-size:.92rem;font-weight:500;margin-bottom:14px}
  .nxs5 .in label b{font-family:'Clash Display',sans-serif;color:var(--pink);font-size:1.05rem}
  .nxs5 input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:6px;border-radius:6px;background:linear-gradient(90deg,var(--pink) var(--p,40%),rgba(255,255,255,.1) var(--p,40%));outline:none}
  .nxs5 input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:var(--pink);cursor:pointer;box-shadow:0 0 0 5px rgba(255,45,122,.2),0 4px 10px rgba(0,0,0,.4)}
  .nxs5 input[type=range]::-moz-range-thumb{width:22px;height:22px;border:none;border-radius:50%;background:var(--pink);cursor:pointer}
  .nxs5 .lbl{font-size:.85rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px}
  .nxs5 .big{font-family:'Clash Display',sans-serif;font-weight:600;font-size:clamp(2.6rem,6vw,3.6rem);color:var(--pink);line-height:1;letter-spacing:-.02em}
  .nxs5 .rsub{color:var(--muted);margin:10px 0 26px;font-size:.95rem}
  .nxs5 .split{display:flex;gap:26px}
  .nxs5 .split .n{font-family:'Clash Display',sans-serif;font-size:1.5rem;font-weight:600;color:var(--pink)}.nxs5 .split .t{font-size:.8rem;color:var(--muted)}
  .nxs5 .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
  .nxs5 .reveal.in{opacity:1;transform:none}
  @media(max-width:900px){.nxs5 .card{grid-template-columns:1fr;gap:34px}}
  @media(max-width:760px){.nxs5 .wrap{padding:60px 22px}}
</style>
  <div class="wrap">
    <div class="head reveal"><span class="eyebrow">Der ROI Ihres Dashboards</span><h2>Weniger Reporting.<br>Mehr Wachstum.</h2><p class="sub">Rechnen Sie kurz nach, was Sie ein veraltetes Reporting wirklich kostet.</p></div>
    <div class="card reveal">
      <div>
        <div class="in"><label>Stunden / Woche fürs Reporting <b data-h>8 h</b></label><input type="range" data-r="hours" min="1" max="40" value="8"></div>
        <div class="in"><label>Beteiligte Mitarbeiter <b data-p>3</b></label><input type="range" data-r="people" min="1" max="20" value="3"></div>
        <div class="in"><label>Kosten / Stunde <b data-rt>60 €</b></label><input type="range" data-r="rate" min="30" max="150" step="5" value="60"></div>
      </div>
      <div>
        <div class="lbl">Eingespart pro Jahr</div>
        <div class="big" data-money>0 €</div>
        <div class="rsub">bei 80 % weniger Reporting-Aufwand durch Ihr Dashboard</div>
        <div class="split">
          <div><div class="n" data-hours>0</div><div class="t">Stunden / Jahr zurück</div></div>
          <div><div class="n" data-days>0</div><div class="t">Arbeitstage / Jahr frei</div></div>
        </div>
      </div>
    </div>
  </div>
<script>
(function(){var w=document.querySelector('.nxs5');if(!w)return;
  var hours=w.querySelector('[data-r="hours"]'),people=w.querySelector('[data-r="people"]'),rate=w.querySelector('[data-r="rate"]');
  var hL=w.querySelector('[data-h]'),pL=w.querySelector('[data-p]'),rL=w.querySelector('[data-rt]'),oM=w.querySelector('[data-money]'),oH=w.querySelector('[data-hours]'),oD=w.querySelector('[data-days]');
  function fmt(n){return n.toLocaleString('de-DE');}
  function setP(el){var p=(el.value-el.min)/(el.max-el.min)*100;el.style.setProperty('--p',p+'%');}
  function calc(){[hours,people,rate].forEach(setP);var h=+hours.value,p=+people.value,r=+rate.value;hL.textContent=h+' h';pL.textContent=p;rL.textContent=r+' €';var sy=Math.round(h*p*0.8*52);oM.textContent=fmt(Math.round(sy*r))+' €';oH.textContent=fmt(sy);oD.textContent=fmt(Math.round(sy/8));}
  [hours,people,rate].forEach(function(el){el.addEventListener('input',calc);});calc();
  var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.15});
  w.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
})();
</script>
</div>

