<!-- SEKTION 4: LÖSUNG -->
<!-- ══════════════════════════════════════════════════════════ -->
<!-- NUROY · SEKTION 04 · LÖSUNG / BENEFITS — eigenständiger Custom-Code-Block -->
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600&f[]=satoshi@400,500,700&display=swap" rel="stylesheet">
<div class="nxs4" id="loesung">
<style>
  .nxs4{--pink:#FF2D7A;--ink:#0A0A0C;--surface:#1C1C22;--surface2:#2A2A32;--line:rgba(255,255,255,.09);--text:#F5F2EC;--muted:#9A968C;
    font-family:'Satoshi',-apple-system,sans-serif;background:var(--ink);color:var(--text);line-height:1.55;-webkit-font-smoothing:antialiased}
  .nxs4 *{box-sizing:border-box;margin:0;padding:0}
  .nxs4 .wrap{max-width:1140px;margin:0 auto;padding:84px 22px}
  .nxs4 .head{max-width:680px;margin-bottom:48px}
  .nxs4 .eyebrow{font-size:12.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);display:inline-flex;align-items:center;gap:9px;margin-bottom:16px}
  .nxs4 .eyebrow::before{content:"";width:26px;height:1.5px;background:var(--pink)}
  .nxs4 h2{font-family:'Clash Display',sans-serif;font-weight:600;font-size:clamp(1.9rem,5.2vw,3rem);letter-spacing:-.02em;line-height:1.05}
  .nxs4 .sub{margin-top:18px;color:var(--muted);font-size:1.05rem}
  .nxs4 .grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
  .nxs4 .ben{background:linear-gradient(165deg,var(--surface2),var(--surface));border:1px solid var(--line);border-radius:18px;padding:24px 20px;transition:transform .25s,border-color .25s}
  .nxs4 .ben:hover{transform:translateY(-5px);border-color:var(--pink)}
  .nxs4 .num{font-family:'Clash Display',sans-serif;font-weight:600;font-size:2.1rem;color:var(--pink);line-height:1}
  .nxs4 .ben h3{font-family:'Clash Display',sans-serif;font-weight:600;font-size:1.02rem;margin:14px 0 6px}
  .nxs4 .ben p{font-size:.86rem;color:var(--muted)}
  .nxs4 .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
  .nxs4 .reveal.in{opacity:1;transform:none}
  @media(max-width:900px){.nxs4 .grid{grid-template-columns:repeat(2,1fr)}.nxs4 .ben:last-child{grid-column:span 2}}
  @media(max-width:760px){.nxs4 .wrap{padding:60px 22px}}
</style>
  <div class="wrap">
    <div class="head reveal"><span class="eyebrow">Was ist ein Dashboard?</span><h2>Alle Kennzahlen.<br>Eine zentrale Übersicht.</h2><p class="sub">Live-Daten, individuelle Ansichten, keine Excel-Acrobatics mehr. Ein System statt zehn Tabs.</p></div>
    <div class="grid">
      <div class="ben reveal"><div class="num" data-count="80" data-suffix="%">0%</div><h3>Zeitersparnis</h3><p>Kein manuelles Copy-Paste mehr.</p></div>
      <div class="ben reveal"><div class="num" data-count="100" data-suffix="%">0%</div><h3>Echtzeit</h3><p>Ihre Daten sind immer aktuell.</p></div>
      <div class="ben reveal"><div class="num">1</div><h3>Wahrheit</h3><p>Alle arbeiten mit denselben Zahlen.</p></div>
      <div class="ben reveal"><div class="num">⚡</div><h3>Schneller</h3><p>Erkenntnisse auf einen Blick.</p></div>
      <div class="ben reveal"><div class="num">🔒</div><h3>Transparenz</h3><p>Jeder sieht, was er sehen soll.</p></div>
    </div>
  </div>
<script>
(function(){var w=document.querySelector('.nxs4');if(!w)return;
  function cnt(el){var t=+el.dataset.count,s=el.dataset.suffix||'',c=0,st=Math.max(1,Math.ceil(t/40));var iv=setInterval(function(){c+=st;if(c>=t){c=t;clearInterval(iv);}el.textContent=c+s;},22);}
  var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');x.target.querySelectorAll('[data-count]').forEach(function(c){if(!c.dataset.done){c.dataset.done=1;cnt(c);}});io.unobserve(x.target);}});},{threshold:.15});
  w.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
})();
</script>
</div>

