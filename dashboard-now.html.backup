<!-- SEKTION 12: BOOKING (von dashboard-jetzt.html) -->
<!-- ══════════════════════════════════════════════════════════ -->
<section class="funnel-booking" id="booking">
  <div class="container">
    <h1 class="funnel-booking-headline">Bereit, das zu bauen?</h1>
    <p class="funnel-booking-subtext">Zwei kurze Fragen, dann geht's los.</p>

    <!-- Qualifizierungs-Flow Container -->
    <div class="qualification-container" id="qualification-container">

      <!-- Frage 1: Interesse -->
      <div class="qualification-step active" id="qualification-step-1">
        <div class="qualification-progress">Schritt 1 von 2</div>
        <div class="qualification-eyebrow">Damit wir gleich konkret werden können —</div>
        <h2 class="qualification-headline">Ich habe Interesse mehr zu erfahren, wie ich alle meine Daten im Überblick habe.</h2>
        <p class="qualification-subtext">Nur wenn Sie wirklich Interesse haben, geht's weiter zur Terminbuchung.</p>

        <div class="qualification-options">
          <button class="qualification-option" onclick="selectInterest('yes')">
            Ja
          </button>
          <button class="qualification-option" onclick="selectInterest('no')">
            Nein
          </button>
        </div>
      </div>

      <!-- Frage 2: Unternehmensgröße -->
      <div class="qualification-step" id="qualification-step-2">
        <div class="qualification-progress">Schritt 2 von 2</div>
        <div class="qualification-eyebrow">Letzte Frage —</div>
        <h2 class="qualification-headline">Wie etabliert ist Ihr Unternehmen bereits?</h2>
        <p class="qualification-subtext">Damit wir direkt passend vorbereitet sind und die richtigen Lösungsansätze mitbringen. Bleibt natürlich komplett unter uns.</p>

        <div class="qualification-options">
          <button class="qualification-option" onclick="selectRevenueRange('revenue-0-100k')">
            Noch in der Startphase
          </button>
          <button class="qualification-option" onclick="selectRevenueRange('revenue-100k-500k')">
            Solide etabliert (ca. 100–500k €/Jahr)
          </button>
          <button class="qualification-option" onclick="selectRevenueRange('revenue-500k-2m')">
            Wachsendes Unternehmen (ca. 500k–2 Mio €/Jahr)
          </button>
          <button class="qualification-option" onclick="selectRevenueRange('revenue-2m-plus')">
            Größeres Unternehmen (über 2 Mio €/Jahr)
          </button>
          <button class="qualification-option" onclick="selectRevenueRange('revenue-prefer-not-say')">
            Bespreche ich lieber direkt mit Ihnen
          </button>
        </div>

        <button class="qualification-back" onclick="showStep(1)">← Zurück</button>
      </div>

    </div>

    <!-- Calendly Container (wird nach Qualifizierung angezeigt) -->
    <div class="calendly-container" id="calendly-container">
      <div class="calendly-header">
        <div class="calendly-eyebrow">Wählen Sie Ihren Termin</div>
        <h2 class="calendly-headline">Bereit. Lassen Sie uns sprechen.</h2>
      </div>

      <!-- Calendly Inline Widget -->
      <div id="calendly-embed"></div>
    </div>

    <!-- Kontaktformular Container (Soft-No) -->
    <div class="contact-form-container" id="contact-form-container">
      <div class="contact-form-header">
        <h2 class="contact-form-headline">Lassen Sie uns persönlich abstimmen, was zu Ihnen passt.</h2>
        <p class="contact-form-subtext">
          Für Ihr Setup schauen wir uns am besten erst Ihre Situation in Ruhe an und melden uns dann mit einem passenden Vorschlag — statt Sie jetzt durch ein Standard-Gespräch zu schicken. Tragen Sie sich ein, und einer aus dem Team meldet sich innerhalb von 1–2 Werktagen.
        </p>
      </div>

      <!-- Kontaktformular -->
      <form class="contact-form" id="contact-form">
        <div class="form-field">
          <label class="form-label" for="contact-name">Name *</label>
          <input class="form-input" type="text" id="contact-name" name="name" required>
        </div>

        <div class="form-field">
          <label class="form-label" for="contact-email">E-Mail *</label>
          <input class="form-input" type="email" id="contact-email" name="email" required>
        </div>

        <div class="form-field">
          <label class="form-label" for="contact-company">Firma *</label>
          <input class="form-input" type="text" id="contact-company" name="company" required>
        </div>

        <div class="form-field">
          <label class="form-label" for="contact-phone">
            Telefon <span class="form-label-optional">(optional)</span>
          </label>
          <input class="form-input" type="tel" id="contact-phone" name="phone">
        </div>

        <div class="form-field">
          <label class="form-label" for="contact-message">
            Kurze Beschreibung eurer Situation <span class="form-label-optional">(optional)</span>
          </label>
          <textarea
            class="form-textarea"
            id="contact-message"
            name="message"
            placeholder="Was ist gerade die größte Reporting- oder Tool-Herausforderung?"
          ></textarea>
        </div>

        <button class="form-submit" type="submit">Absenden</button>
      </form>

      <!-- Success Message -->
      <div class="contact-form-success" id="contact-form-success">
        <div class="success-icon">✓</div>
        <h3 class="success-headline">Danke!</h3>
        <p class="success-text">Wir melden uns innerhalb von 1–2 Werktagen bei Ihnen. Bis dahin: schöne Zeit.</p>
      </div>
    </div>

    <!-- Trust Elemente -->
    <div class="funnel-booking-trust">
      <div class="funnel-booking-trust-item">✓ Keine Verkaufsmasche</div>
      <div class="funnel-booking-trust-item">✓ Konkrete Antworten auf Ihre Situation</div>
      <div class="funnel-booking-trust-item">✓ Wenn es nicht passt, sagen wir's offen</div>
    </div>
  </div>
</section>

